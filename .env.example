NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Demonstração explícita, sem contas reais, com dados apenas neste navegador.
# Mantenha false em produção.
NEXT_PUBLIC_ENABLE_DEMO=false

# Assinaturas: variáveis privadas, somente no servidor. Nunca use NEXT_PUBLIC_ nestas chaves.
SUPABASE_SERVICE_ROLE_KEY=
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_COLLECTOR_ID=
# Opcional: ID da aplicação para conferir a origem dos contratos.
MERCADO_PAGO_APPLICATION_ID=
MERCADO_PAGO_WEBHOOK_SECRET=
# test ou production. As credenciais e a conta recebedora devem pertencer ao mesmo ambiente.
MERCADO_PAGO_ENVIRONMENT=test
# Gere um segredo aleatório de pelo menos 32 caracteres. A Vercel envia Bearer CRON_SECRET.
CRON_SECRET=
