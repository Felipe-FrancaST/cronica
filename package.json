{
  "name": "cronica-rpg",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=2 tests/*.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests *.config.ts package.json tsconfig.json README.md LEIA-ME-ATUALIZACAO.md",
    "test:vtt": "playwright test --config playwright.vtt.config.ts",
    "format:check": "prettier --check src tests *.config.ts package.json tsconfig.json README.md LEIA-ME-ATUALIZACAO.md",
    "test:integration": "playwright test --config playwright.integration.config.ts",
    "test:items": "playwright test --config playwright.items.config.ts",
    "test:scenery": "playwright test --config playwright.scenery.config.ts",
    "test:rewards": "playwright test --config playwright.rewards.config.ts",
    "test:performance": "playwright test --config playwright.performance.config.ts",
    "test:master-panel": "playwright test --config playwright.master-panel.config.ts",
    "benchmark:grid": "node --import tsx scripts/benchmark-scenery.ts",
    "test:billing": "playwright test --config playwright.billing.config.ts",
    "test:pix": "playwright test --config playwright.pix.config.ts",
    "test:account": "playwright test --config playwright.account.config.ts"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "lucide-react": "^0.468.0",
    "next": "16.3.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "0.186.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "0.186.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
